#include <windows.h>

1 ICON "mintdesk.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,8,0,0
 PRODUCTVERSION 0,8,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MCC\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 MCC\0"
            VALUE "FileDescription", "薄荷桌面助手 / MintDesk\0"
            VALUE "FileVersion", "0.8.0\0"
            VALUE "InternalName", "MintDesk\0"
            VALUE "OriginalFilename", "MintDesk.exe\0"
            VALUE "ProductName", "薄荷桌面助手 / MintDesk\0"
            VALUE "ProductVersion", "0.8.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
